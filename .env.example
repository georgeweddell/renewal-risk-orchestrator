# Copy to .env and fill in. .env is gitignored; nothing secret lives in code.

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# How much the model thinks per turn: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
# If a safety classifier declines a request, retry it server-side on
# Anthropic's recommended fallback model instead of failing the run.
ANTHROPIC_FALLBACKS=true
# Return the model's short progress notes between tool calls, for the run trace.
ANTHROPIC_PROGRESS_UPDATES=true

# --- Mode --------------------------------------------------------------------
# mock: seeded local data, no third-party accounts needed.
# live: real HubSpot / GitHub / PostHog (Phase 3+).
RRO_MODE=mock
# Per-system overrides; each defaults to RRO_MODE.
# CRM_BACKEND=mock
# TICKETS_BACKEND=mock
# USAGE_BACKEND=mock

# Safety net on the agent loop.
RRO_MAX_AGENT_TURNS=25

# --- Live credentials (Phase 3) ------------------------------------------------
# Each token gets the least a run needs. Seeding (`rro seed-live`) needs more, so
# it has its own tokens below; runs never see them.
#
# HubSpot: private app token from your developer TEST account. Runtime scopes:
# crm.objects.companies.read, crm.objects.deals.read, crm.objects.deals.write,
# crm.objects.owners.read.
HUBSPOT_ACCESS_TOKEN=
# GitHub Issues as the ticketing system: owner/repo, and a fine-grained token
# for that one repo with Issues: read-only.
GITHUB_TICKETS_REPO=
GITHUB_TOKEN=
# Seeding only. HubSpot: the runtime scopes plus crm.objects.companies.write and
# crm.schemas.companies.write / crm.schemas.deals.write (custom properties).
# GitHub: Issues read and write on the tickets repo. Leave empty to seed with the
# runtime tokens (seed-live will remind you).
HUBSPOT_SEED_ACCESS_TOKEN=
GITHUB_SEED_TOKEN=
# PostHog: us.posthog.com or eu.posthog.com, the project ID (a number), the
# project API key (phc_..., sends events; seeding only) and a personal API key
# (phx_..., reads) with only the query:read and project:read scopes, limited to
# this one project.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=

# HubSpot's own MCP server (optional): client ID and secret of an MCP connector
# created in your HubSpot developer account (Development -> MCP Connectors).
# Redirect URL on the connector: http://localhost:8912/oauth/callback
HUBSPOT_MCP_CLIENT_ID=
HUBSPOT_MCP_CLIENT_SECRET=

# --- Slack approvals (Phase 4) -------------------------------------------------
# Bot token (xoxb-...) and app-level token for Socket Mode (xapp-...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Channel ID (C...) where approval requests are posted. Invite the bot to it.
SLACK_APPROVALS_CHANNEL=
# Comma-separated Slack member IDs (U...) allowed to approve or reject. Required:
# with it empty nobody can decide in Slack, and the listener won't start.
# (Slack profile -> ... -> Copy member ID.)
SLACK_APPROVERS=

# --- Paid evidence over x402 (optional, testnet only) --------------------------
# Off by default. When on, the agent can propose buying company news; the spend
# rules (budget, allowlist, auto-approve threshold) are in config/policy.yaml.
# RRO_PAYMENTS_ENABLED=false
# mock: simulated seller and receipts, no wallet. x402: real testnet payments
# (needs `uv sync --extra payments`). Defaults to x402 in live mode, mock otherwise.
# EVIDENCE_BACKEND=mock
# A DEDICATED TEST WALLET's private key (Base Sepolia, test USDC). Never a wallet
# that holds real money. Only the evidence server receives it.
# X402_BUYER_PRIVATE_KEY=
# The local stand-in seller's payout address (python -m evidence_seller).
# X402_SELLER_ADDRESS=
