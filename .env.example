# Copy to .env and fill in. .env is gitignored; nothing secret lives in code.

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# How much the model thinks per turn: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
# If a safety classifier declines a request, retry it server-side on
# Anthropic's recommended fallback model instead of failing the run.
ANTHROPIC_FALLBACKS=true
# Return the model's short progress notes between tool calls, for the run trace.
ANTHROPIC_PROGRESS_UPDATES=true

# --- Mode --------------------------------------------------------------------
# mock: seeded local data, no third-party accounts needed.
# live: real HubSpot / GitHub / PostHog (Phase 3+).
RRO_MODE=mock
# Per-system overrides; each defaults to RRO_MODE.
# CRM_BACKEND=mock
# TICKETS_BACKEND=mock
# USAGE_BACKEND=mock

# Safety net on the agent loop.
RRO_MAX_AGENT_TURNS=25

# --- Live credentials (Phase 3) ------------------------------------------------
# HubSpot: private app access token from your developer TEST account.
HUBSPOT_ACCESS_TOKEN=
# GitHub Issues as the ticketing system: owner/repo, and a fine-grained token
# with Issues read/write on that one repo.
GITHUB_TICKETS_REPO=
GITHUB_TOKEN=
# PostHog: us.posthog.com or eu.posthog.com, the project ID (a number), the
# project API key (phc_..., sends events) and a personal API key (phx_..., reads).
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=

# HubSpot's own MCP server (optional): client ID and secret of an MCP connector
# created in your HubSpot developer account (Development -> MCP Connectors).
# Redirect URL on the connector: http://localhost:8912/oauth/callback
HUBSPOT_MCP_CLIENT_ID=
HUBSPOT_MCP_CLIENT_SECRET=

# --- Slack approvals (Phase 4) -------------------------------------------------
# Bot token (xoxb-...) and app-level token for Socket Mode (xapp-...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Channel ID (C...) where approval requests are posted. Invite the bot to it.
SLACK_APPROVALS_CHANNEL=
# Optional: comma-separated Slack member IDs (U...) allowed to approve or reject.
# Empty means anyone in the channel can decide.
SLACK_APPROVERS=
